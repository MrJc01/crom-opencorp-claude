{
  "name": "opencorp-claude",
  "version": "0.7.0",
  "description": "OpenCorp com o Claude Agent SDK como motor base (fork de opencorp)",
  "license": "MIT",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "opencorp": "./bin/opencorp.mjs",
    "oc": "./bin/oc.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:web": "vite build",
    "watch:web": "vite build --watch",
    "build:css": "tailwindcss -i src/web/css/app.css -o web-dist/tailwind.css --minify",
    "serve": "node bin/opencorp.mjs serve --host 0.0.0.0 --port 4100",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "dev": "tsx watch src/cli/index.ts",
    "cleanup-continue": "node src/server/scripts/cleanupContinue.ts",
    "test:real": "vitest run tests/real"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.116",
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@assistant-ui/react": "^0.15.21",
    "@assistant-ui/react-ai-sdk": "^1.4.12",
    "@assistant-ui/react-markdown": "^0.14.16",
    "@clack/prompts": "^1.7.0",
    "@xyflow/react": "^12.11.6",
    "ai": "^7.0.113",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "lucide-react": "^1.48.0",
    "mermaid": "^11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "daisyui": "^5.7.22",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
